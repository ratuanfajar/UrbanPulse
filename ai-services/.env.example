# ── Slum Detection API — configuration ──────────────────────────────────────
# Copy to `.env` (same folder as app.py) and adjust. All values are optional;
# the core API runs without any of them. GEE is only needed for predicting
# areas OUTSIDE the local data.

# --- Local data (always available, no GEE needed) ----------------------------
# Folder with model.joblib + model_metadata.json (defaults to ../models).
MODELS_DIR=../models
# Kelurahan boundary polygons used for the map + point-in-polygon lookup.
# Default labels.geojson holds the 4 training cities (with the slum label).
# Point it at a nationwide kelurahan file to show/lookup more areas on the map.
BOUNDARIES_PATH=../data/processed/labels.geojson
# Pre-extracted features for the training units (instant predictions, no GEE).
FEATURES_CSV=../data/processed/features_buildings.csv

# --- Live pipeline: predict ANY area in Indonesia (requires GEE) -------------
# Leave GEE_PROJECT empty to DISABLE live prediction (clicks outside the local
# data and location searches will return 503). Set it to your Earth Engine
# project id (the same one used in script 04) to enable prediction anywhere.
GEE_PROJECT=
# When a click/search falls OUTSIDE every known kelurahan, the API extracts
# features for a circular buffer of this radius (meters) around the point.
# ~500 m roughly matches a small urban kelurahan footprint.
RADIUS_M=500
# Folder where freshly extracted features are cached (repeat clicks skip GEE).
FEATURE_CACHE_DIR=./feature_cache
# Year for the satellite composites (must match training: 2023).
PIPELINE_YEAR=2023

# --- LLM explanation (optional) ----------------------------------------------
# Without a key, the API still returns a deterministic Indonesian explanation.
OPENAI_API_KEY=
# For OpenRouter / other OpenAI-compatible providers, set the base URL + model.
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini

# Web search
TAVILY_API_KEY= ""
# basic | advanced
SEARCH_DEPTH=advanced
SEARCH_MAX_RESULTS=6

# ── Server ─────────────────────────────────────────────────────────
APP_PORT=5000
LOG_LEVEL=info